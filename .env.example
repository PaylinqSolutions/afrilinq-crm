# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite Postgres stored in ./.data/pglite
# (local development and demos). For production, point it at Supabase Postgres, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
# postgresql://[user[:password]@][host][:port][/dbname][?param1=value1&...]
DATABASE_URL=
# Directory for the embedded database when DATABASE_URL is empty.
PGLITE_DIR=./.data/pglite
# Load realistic demo data on first start when the database is empty (true/false).
AUTO_SEED=true

# --- App --------------------------------------------------------------------
# Public base URL, used for invitation and customer ticket links.
APP_URL=http://localhost:3000
# Secret used to protect /api/cron/sweep. Generate with: openssl rand -hex 32
CRON_SECRET=
# Private upload directory (never served publicly).
STORAGE_DIR=./storage
# Run SLA and automation sweeps in-process every N seconds (0 disables; use the cron endpoint instead).
SWEEP_INTERVAL_SECONDS=60

# --- Optional integration adapters (all "Not configured" when empty) -------
# Email via SMTP-compatible HTTP provider
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
# SMS
SMS_PROVIDER=
SMS_API_KEY=
# WhatsApp Business
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
# Calendar
CALENDAR_PROVIDER=
CALENDAR_API_KEY=
# Telephony
TELEPHONY_PROVIDER=
TELEPHONY_API_KEY=
# External issue tracker (engineering escalations)
ISSUE_TRACKER_PROVIDER=
ISSUE_TRACKER_API_KEY=
ISSUE_TRACKER_BASE_URL=
